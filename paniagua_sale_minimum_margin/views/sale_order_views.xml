<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ocultar el campo de margen que aparece debajo del total -->
    <record id="sale_order_hide_margin_bottom" model="ir.ui.view">
        <field name="name">sale.order.hide.margin.bottom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_margin.sale_margin_sale_order"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_totals']/following-sibling::div[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>

